{% extends "layouts/base.njk" %}

{% block content %}
  <section class="specialty-detail-hero section-dark">
    <div class="container specialty-detail-grid">
      <div>
        <a class="back-link" href="/especialidades"><span aria-hidden="true">←</span> Todas las especialidades</a>
        <p class="eyebrow eyebrow-light"><span></span>{{ page.eyebrow }}</p>
        <h1>{{ page.title }}</h1>
      </div>
      <div class="specialty-summary"><span>{{ page.number }}</span><p>{{ page.summary }}</p><a class="button button-light" href="/contacto">{{ page.cta }}</a></div>
    </div>
  </section>

  <section class="section problem-section" aria-labelledby="problem-title">
    <div class="container problem-grid">
      <div><p class="eyebrow"><span></span>El problema</p><h2 id="problem-title">La herramienta no debe ocultar el proceso.</h2></div>
      <div><p class="lead">{{ page.problem }}</p><div class="outcome-box"><span>Resultado buscado</span><strong>{{ page.outcome }}</strong></div></div>
    </div>
  </section>

  <section class="section capability-section" aria-labelledby="capability-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow"><span></span>Capacidades</p><h2 id="capability-title">De la necesidad a la operación.</h2></div><p>El alcance final se define después del diagnóstico; estas capacidades muestran cómo podemos acompañar el proceso.</p></div>
      <div class="detail-capability-grid">
        {% for capability in page.capabilities %}
          <article><span>0{{ loop.index }}</span><h3>{{ capability.title }}</h3><p>{{ capability.description }}</p></article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section fit-section" aria-labelledby="fit-title">
    <div class="container fit-grid">
      <div><p class="eyebrow eyebrow-light"><span></span>Cuándo aporta valor</p><h2 id="fit-title">Esta especialidad puede ayudarte si…</h2></div>
      <ul>{% for item in page.idealFor %}<li><span>0{{ loop.index }}</span><p>{{ item }}</p></li>{% endfor %}</ul>
    </div>
  </section>

  <section class="section specialty-method" aria-labelledby="specialty-method-title">
    <div class="container">
      <div class="section-heading section-heading-compact"><div><p class="eyebrow"><span></span>Recorrido</p><h2 id="specialty-method-title">Un proceso visible de principio a fin.</h2></div><p>La complejidad puede variar; la disciplina del proceso se mantiene.</p></div>
      <ol>{% for step in page.steps %}<li><span>0{{ loop.index }}</span><strong>{{ step }}</strong></li>{% endfor %}</ol>
    </div>
  </section>

  <section class="contact-cta" aria-labelledby="detail-contact-title">
    <div class="container contact-grid">
      <div><p class="eyebrow eyebrow-light"><span></span>{{ page.title }}</p><h2 id="detail-contact-title">Comencemos por entender el contexto.</h2></div>
      <div><p>No necesitas llegar con una solución definida. Revisaremos contigo el problema, las restricciones y el resultado esperado.</p><a class="button button-signal" href="/contacto">{{ page.cta }} <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
{% endblock %}

