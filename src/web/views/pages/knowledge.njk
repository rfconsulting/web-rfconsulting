{% extends "layouts/base.njk" %}

{% block content %}
  <section class="knowledge-hero section-dark">
    <div class="container knowledge-hero-grid">
      <div><p class="eyebrow eyebrow-light"><span></span>Conocimiento</p><h1>Ideas útiles para decisiones reales.</h1></div>
      <p>Explicamos tecnología, operación y negocio con lenguaje claro, límites explícitos y conexiones prácticas con la empresa.</p>
    </div>
  </section>

  <section class="section featured-article" aria-labelledby="featured-title">
    <div class="container featured-article-grid">
      {% set featured = page.articles[0] %}
      <div class="editorial-visual" aria-hidden="true"><span>01</span><strong>Diagnosticar<br>antes de<br>reaccionar.</strong><i></i></div>
      <article>
        <p class="article-meta"><span>{{ featured.category }}</span><span>{{ featured.readingTime }}</span></p>
        <h2 id="featured-title"><a href="/blog/{{ featured.slug }}">{{ featured.title }}</a></h2>
        <p class="lead">{{ featured.summary }}</p>
        <a class="text-link" href="/blog/{{ featured.slug }}">Leer artículo <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </section>

  <section class="section knowledge-list" aria-labelledby="latest-title">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow"><span></span>Publicaciones</p><h2 id="latest-title">Aprender para decidir mejor.</h2></div><p>Contenido recuperado y revisado desde la publicación original de RF Consulting.</p></div>
      <div class="knowledge-rows">
        {% for article in page.articles %}
          <article><span class="knowledge-number">0{{ loop.index }}</span><div><p>{{ article.category }}</p><h3><a href="/blog/{{ article.slug }}">{{ article.title }}</a></h3></div><p>{{ article.summary }}</p><span class="knowledge-time">{{ article.readingTime }}</span><a href="/blog/{{ article.slug }}" aria-label="Leer {{ article.title }}">→</a></article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="contact-cta" aria-labelledby="knowledge-contact-title">
    <div class="container contact-grid"><div><p class="eyebrow eyebrow-light"><span></span>De la idea a la acción</p><h2 id="knowledge-contact-title">¿Hay un problema tecnológico detrás de tu búsqueda?</h2></div><div><p>Podemos ayudarte a convertir la pregunta en un diagnóstico y un siguiente paso concreto.</p><a class="button button-signal" href="/contacto">Conversemos <span aria-hidden="true">→</span></a></div></div>
  </section>
{% endblock %}

