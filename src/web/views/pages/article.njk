{% extends "layouts/base.njk" %}

{% block content %}
  <article class="article-page">
    <header class="article-hero section-dark">
      <div class="container article-hero-inner">
        <a class="back-link" href="/blog"><span aria-hidden="true">←</span> Volver a Conocimiento</a>
        <p class="eyebrow eyebrow-light"><span></span>{{ page.category }}</p>
        <h1>{{ page.title }}</h1>
        <p class="article-summary">{{ page.summary }}</p>
        <div class="article-byline"><span>RF Consulting</span><span>Publicado: {{ page.publishedAt }}</span><span>Actualizado: {{ page.updatedAt }}</span><span>{{ page.readingTime }}</span></div>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="article-aside" aria-label="Información del artículo"><span>Contenido revisado</span><p>Este artículo fue recuperado del sitio anterior y reeditado para mejorar claridad, precisión y utilidad.</p><a href="{{ page.relatedService.href }}">{{ page.relatedService.label }} →</a></aside>
      <div class="article-body">
        {% if page.disclaimer %}<p class="article-disclaimer"><strong>Importante:</strong> {{ page.disclaimer }}</p>{% endif %}
        {% for paragraph in page.introduction %}<p class="article-intro">{{ paragraph }}</p>{% endfor %}
        {% for section in page.sections %}
          <section>
            <h2>{{ section.title }}</h2>
            {% for paragraph in section.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
            {% if section.items %}<ul>{% for item in section.items %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
            {% if section.note %}<p class="article-note">{{ section.note }}</p>{% endif %}
          </section>
        {% endfor %}
        <section class="article-conclusion"><h2>Conclusión</h2><p>{{ page.conclusion }}</p></section>
        {% if page.sources %}<section class="article-sources"><h2>Fuentes oficiales consultadas</h2><ul>{% for source in page.sources %}<li><a href="{{ source.url }}" target="_blank" rel="external noopener">{{ source.label }} <span aria-hidden="true">↗</span></a></li>{% endfor %}</ul></section>{% endif %}
      </div>
    </div>

    <section class="article-cta"><div class="container"><div><span>Servicio relacionado</span><h2>Convierte el conocimiento en un siguiente paso.</h2></div><a class="button button-light" href="{{ page.relatedService.href }}">{{ page.relatedService.label }}</a></div></section>
  </article>
{% endblock %}

