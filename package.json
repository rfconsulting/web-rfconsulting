{
  "name": "rfcpty",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio institucional de RF Consulting",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "package:cpanel": "npm run build && node scripts/prepare-cpanel.mjs",
    "start": "node app.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "5.2.1",
    "nunjucks": "3.2.4"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/nunjucks": "3.2.6",
    "supertest": "7.1.4",
    "@types/supertest": "6.0.3",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
